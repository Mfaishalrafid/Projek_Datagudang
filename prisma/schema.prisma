generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BAN
  FILTER_OLI
  REM_KAMPAS
  TRANSMISI
  MESIN
  ELEKTRIKAL
  OTHERS
}

enum VehicleCode {
  CDE
  CDD
  BV
  L300
}

enum VehicleType {
  ENGKEL
  DOUBLE
  BLIND_VAN
  L300
}

enum Condition {
  LAYAK_JUAL
  RUSAK
}

enum BuyerType {
  PELANGGAN_UMUM
  MITRA_BENGKEL
  INTERNAL
}

enum SaleStatus {
  APPROVAL
  TERJUAL
  BATAL
}

enum UsedGoodsCondition {
  LAYAK_JUAL
  TIDAK_LAYAK
}

enum UsedGoodsCategory {
  KARDUS_KARTON
  PLASTIK
  BESI_LOGAM
  KERTAS_ARSIP
  KAYU_PALET
  ELEKTRONIK_BEKAS
  TEKSTIL_KAIN
  KACA
  LAINNYA
}

enum UsedGoodsUnit {
  PCS
  KG
  LEMBAR
  IKAT
  KARUNG
  UNIT
  SET
  ROLL
  DUS
}

enum SgaEligibilityStatus {
  LAYAK_JUAL
  TIDAK_LAYAK
}

enum SgaTransactionStatus {
  TERSEDIA
  DALAM_ORDER
  TERJUAL
}

enum Role {
  SUPER_ADMIN
  ADMIN_PUSAT
  ADMIN_CABANG
  KARYAWAN_CABANG
}

model Branch {
  id         String      @id @default(cuid())
  name       String      @unique
  code       String?     @unique
  regional   String?
  city       String?
  address    String?
  phone      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  spareparts Sparepart[]
  usedGoods  UsedGoods[]
  sgaItems   SgaItem[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sgaItems      SgaItem[]      @relation("SgaItemCreatedBy")
  sgaSaleOrders SgaSaleOrder[] @relation("SgaSaleOrderCreatedBy")

  @@index([role])
  @@index([branchId])
  @@index([isActive])
}

model Sparepart {
  id              String      @id @default(cuid())
  pjpp            String
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  removedDate     DateTime?   @db.Date
  name            String
  category        Category
  plateNumber     String
  vehicleCode     VehicleCode
  vehicleType     VehicleType
  condition       Condition
  storageLocation String
  notes           String?     @db.Text
  saleOrders      SaleOrder[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([branchId])
  @@index([category])
  @@index([condition])
  @@index([vehicleType])
  @@index([removedDate])
}

model SaleOrder {
  id          String     @id @default(cuid())
  sparepartId String
  sparepart   Sparepart  @relation(fields: [sparepartId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerType   BuyerType
  price       Decimal    @db.Decimal(14, 2)
  saleDate    DateTime   @db.Date
  status      SaleStatus @default(APPROVAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sparepartId])
  @@index([status])
  @@index([saleDate])
}

model UsedGoods {
  id                String               @id @default(cuid())
  code              String               @unique
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inputDate         DateTime             @db.Date
  name              String
  category          UsedGoodsCategory
  qty               Decimal              @db.Decimal(14, 2)
  unit              UsedGoodsUnit
  estimatedWeightKg Decimal?             @db.Decimal(12, 2)
  estimatedPrice    Decimal?             @db.Decimal(14, 2)
  condition         UsedGoodsCondition
  storageLocation   String?
  pic               String?
  notes             String?              @db.Text
  saleOrders        UsedGoodsSaleOrder[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([branchId])
  @@index([category])
  @@index([condition])
  @@index([inputDate])
}

model UsedGoodsSaleOrder {
  id          String     @id @default(cuid())
  usedGoodsId String
  usedGoods   UsedGoods  @relation(fields: [usedGoodsId], references: [id], onDelete: Cascade)
  qty         Decimal    @db.Decimal(14, 2)
  buyerName   String
  price       Decimal    @db.Decimal(14, 2)
  saleDate    DateTime   @db.Date
  status      SaleStatus @default(APPROVAL)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([usedGoodsId])
  @@index([status])
  @@index([saleDate])
}

model SgaItem {
  id                String               @id @default(cuid())
  tlsNumber         String               @unique
  inputDate         DateTime             @db.Date
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  itemName          String
  quantity          Int
  picName           String
  eligibilityStatus SgaEligibilityStatus
  transactionStatus SgaTransactionStatus @default(TERSEDIA)
  note              String?              @db.Text
  createdById       String?
  createdBy         User?                @relation("SgaItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  saleOrders        SgaSaleOrder[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([branchId])
  @@index([inputDate])
  @@index([eligibilityStatus])
  @@index([transactionStatus])
  @@index([picName])
}

model SgaSaleOrder {
  id          String     @id @default(cuid())
  sgaItemId   String
  sgaItem     SgaItem    @relation(fields: [sgaItemId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerType   String?
  salePrice   Decimal    @db.Decimal(14, 2)
  saleDate    DateTime   @db.Date
  status      SaleStatus @default(APPROVAL)
  note        String?    @db.Text
  createdById String?
  createdBy   User?      @relation("SgaSaleOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sgaItemId])
  @@index([status])
  @@index([saleDate])
}
